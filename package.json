    "@nuxt/devtools": "^3.2.4",
    "@nuxt/eslint": "1.17.0",
    "@nuxt/image": "^2.1.0",
    "@nuxt/ui": "^4.11.3",
    "@nuxtjs/seo": "^5.3.16",
    "@takumi-rs/core": "^1.0.16",
    "better-sqlite3": "^12.9.0",
    "eslint": "^10.12.0",
    "feed": "^6.0.0",
    "nuxt": "^4.5.2",
    "pnpm": "^11.0.3",
    "textlint": "^15.8.0",
    "textlint-rule-preset-ja-spacing": "^2.4.3",
